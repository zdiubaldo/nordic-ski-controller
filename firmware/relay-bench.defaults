# Opt-in Waveshare unloaded bench mapping; do not include for machine operation.
CONFIG_NORDIC_SOFTWARE_TEST=y
CONFIG_NORDIC_RELAY_CONTROL=y
CONFIG_NORDIC_RELAY_START=1
CONFIG_NORDIC_RELAY_STOP=6
CONFIG_NORDIC_RELAY_SPEED_UP=2
CONFIG_NORDIC_RELAY_SPEED_DOWN=3
CONFIG_NORDIC_RELAY_INCLINE_UP=4
CONFIG_NORDIC_RELAY_INCLINE_DOWN=5
CONFIG_NORDIC_RELAY_PULSE_MS=500
