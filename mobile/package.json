{
  "name": "@nordic/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/bundle-web.cjs && expo start --dev-client",
    "typecheck": "node scripts/bundle-web.cjs && tsc --noEmit",
    "export:android": "node scripts/bundle-web.cjs && expo export --platform android",
    "export:ios": "node scripts/bundle-web.cjs && expo export --platform ios",
    "test": "node tests/ble.test.cjs && node tests/web-bridge.test.cjs",
    "bundle:web": "node scripts/bundle-web.cjs"
  },
  "dependencies": {
    "@nordic/controller-client": "workspace:*",
    "expo": "57.0.30",
    "expo-dev-client": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-manager": "12.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
